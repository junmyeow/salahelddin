---
import SectionHead from './SectionHead.astro';
import { toArabicDigits } from '../data/taxonomy';

interface Props {
  eras: {
    id: string;
    label: string;
    startYear: number;
    endYear: number;
    blurb: string;
    keyEvents: { year: number; title: string }[];
  }[];
  counts: Record<string, number>;
}

const { eras, counts } = Astro.props;
---

<section id="timeline" aria-labelledby="timeline-title" class="scroll-mt-24">
  <SectionHead
    id="timeline-title"
    eyebrow="٥٣٢ – ٥٨٩ هـ"
    title="الخط الزمني"
    subtitle="اختر حقبةً لتصفية الدليل على المواد المتعلّقة بها."
    class="mb-10"
  />

  <div class="relative">
    {/* الخيط الذهبي */}
    <div
      class="pointer-events-none absolute top-[3.4rem] right-0 left-0 h-px bg-gradient-to-l from-transparent via-gold-500/45 to-transparent"
      aria-hidden="true"
    >
    </div>

    <ol
      role="list"
      class="thin-scroll -mx-4 flex snap-x snap-mandatory justify-center gap-3 overflow-x-auto px-4 pb-3 sm:mx-0 sm:px-0"
    >
      {
        eras.map((era) => (
          <li class="w-[17rem] shrink-0 snap-start sm:w-auto sm:flex-1">
            <button
              type="button"
              data-era-btn={era.id}
              aria-pressed="false"
              class="group flex h-full w-full flex-col items-center rounded-2xl border border-transparent p-4 text-center transition hover:border-parchment-300 hover:bg-parchment-50 aria-pressed:border-gold-400 aria-pressed:bg-parchment-50 dark:hover:border-night-700 dark:hover:bg-night-900 dark:aria-pressed:border-gold-600 dark:aria-pressed:bg-night-900"
            >
              <span
                class="grid size-12 place-items-center rounded-full border-2 border-gold-500/60 bg-parchment-100 text-sm font-bold text-gold-700 transition group-hover:border-gold-500 group-aria-pressed:border-teal-700 group-aria-pressed:bg-teal-800 group-aria-pressed:text-parchment-50 dark:bg-night-950 dark:text-gold-400 dark:group-aria-pressed:bg-teal-700"
                aria-hidden="true"
              >
                ◈
              </span>

              {/* ارتفاع أدنى ثابت ⇒ تتحاذى السنوات والنبذ عبر الأعمدة رغم اختلاف طول العناوين */}
              <span class="mt-4 flex min-h-[3.5rem] items-center font-display text-xl leading-[1.45] font-bold text-ink-900 dark:text-parchment-100">
                {era.label}
              </span>
              <span class="mt-1 block text-base font-medium text-gold-700 dark:text-gold-400">
                {toArabicDigits(era.startYear)}–{toArabicDigits(era.endYear)}م
              </span>
              {/* لا تضف block هنا: يبطل display:-webkit-box الذي يحتاجه line-clamp */}
              <span class="mt-3 line-clamp-4 text-[0.95rem] leading-relaxed text-ink-600 dark:text-parchment-300/70">
                {era.blurb}
              </span>
              <span class="mt-auto block pt-4">
                <span class="inline-block rounded-full bg-parchment-200 px-3 py-1 text-sm text-ink-600 dark:bg-night-800 dark:text-parchment-300/75">
                  {toArabicDigits(counts[era.id] ?? 0)} مادة
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>

  {/* تفاصيل الحقبة المختارة */}
  <div
    id="era-detail"
    hidden
    class="mt-6 rounded-2xl border border-gold-400/50 bg-gold-200/25 p-7 text-center dark:border-gold-600/40 dark:bg-night-900"
  >
    <h3 id="era-detail-title" class="font-display text-2xl font-bold text-ink-900 dark:text-parchment-100"></h3>
    <p id="era-detail-blurb" class="mx-auto mt-3 max-w-2xl text-lg leading-relaxed text-ink-700 dark:text-parchment-300/80"></p>
    <ul id="era-detail-events" class="mt-6 flex flex-wrap justify-center gap-2.5"></ul>
    <button
      type="button"
      id="era-clear"
      class="mt-6 rounded-lg border border-ink-500/30 px-4 py-2 text-base text-ink-600 transition hover:border-crimson-500 hover:text-crimson-700 dark:border-night-700 dark:text-parchment-300/80"
    >
      إلغاء التصفية
    </button>
  </div>

  {/* بيانات الحقب للسكربت */}
  <script type="application/json" id="eras-data" set:html={JSON.stringify(eras)} is:inline />
</section>
