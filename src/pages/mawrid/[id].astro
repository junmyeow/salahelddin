---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmbedPlayer from '../../components/EmbedPlayer.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import Thumb from '../../components/Thumb.astro';
import { withBase } from '../../lib/url';
import {
  formatOf,
  topicLabel,
  platformLabel,
  formatDate,
  formatDuration,
  formatYearRange,
  toArabicDigits,
} from '../../data/taxonomy';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  const eras = await getCollection('eras');
  const eraMap = Object.fromEntries(eras.map((e) => [e.id, e.data]));

  return resources.map((entry) => {
    const related = resources
      .filter((r) => r.id !== entry.id)
      .map((r) => ({
        r,
        score:
          (r.data.historical.eraId === entry.data.historical.eraId ? 3 : 0) +
          r.data.topics.filter((t) => entry.data.topics.includes(t)).length * 2 +
          (r.data.format === entry.data.format ? 1 : 0),
      }))
      .filter((x) => x.score > 0)
      .sort((a, b) => b.score - a.score || b.r.data.curatorScore - a.r.data.curatorScore)
      .slice(0, 3)
      .map((x) => x.r);

    return {
      params: { id: entry.id },
      props: { entry, era: eraMap[entry.data.historical.eraId], related, eraMap },
    };
  });
}

const { entry, era, related, eraMap } = Astro.props;
const d = entry.data;
const fmt = formatOf(d.format);

const LICENSES: Record<string, string> = {
  'public-domain': 'ملك عام',
  'standard-youtube': 'رخصة يوتيوب القياسية',
  'all-rights-reserved': 'كل الحقوق محفوظة لصاحبها',
  'CC BY 4.0': 'المشاع الإبداعي — نسب المصنَّف ٤٫٠',
  'CC BY-SA 4.0': 'المشاع الإبداعي — نسب المصنَّف/الترخيص بالمثل ٤٫٠',
};

const facts = [
  { k: 'النوع', v: fmt?.label },
  { k: 'المنصّة', v: platformLabel(d.sourcePlatform) },
  { k: 'تاريخ النشر', v: formatDate(d.publishedDate) },
  { k: 'الحقبة', v: era?.label },
  { k: 'المدى التاريخي', v: formatYearRange(d.historical.startYear, d.historical.endYear) },
  { k: 'المدّة', v: formatDuration(d.duration) },
  { k: 'الصفحات', v: d.pageCount ? `${toArabicDigits(d.pageCount)} صفحة` : null },
  { k: 'أُضيف إلى الأرشيف', v: formatDate(d.addedDate) },
].filter((f) => f.v);

const outboundLabel =
  d.format === 'book' || d.format === 'primary-source'
    ? 'اقرأ في المصدر الأصلي'
    : d.format === 'video' || d.format === 'audio'
      ? 'شاهد على المنصّة الأصلية'
      : 'افتح الصفحة الأصلية';
---

<BaseLayout title={d.title} description={d.summary}>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    {/* مسار التنقّل */}
    <nav aria-label="مسار التنقّل" class="mb-8 text-center text-base text-ink-500 dark:text-parchment-300/60">
      <a href={withBase('/')} class="transition hover:text-teal-700 dark:hover:text-teal-300">الدليل</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <a
        href={withBase(`/?era=${d.historical.eraId}`)}
        class="transition hover:text-teal-700 dark:hover:text-teal-300"
      >
        {era?.label}
      </a>
    </nav>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
      {/* ————— العمود الرئيسي ————— */}
      <div>
        <div class="flex flex-wrap items-center justify-center gap-2.5">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-800 px-4 py-1.5 text-base font-semibold text-parchment-50 dark:bg-teal-700">
            <span aria-hidden="true">{fmt?.icon}</span>{fmt?.label}
          </span>
          <span class="rounded-full border border-gold-500/50 px-4 py-1.5 text-base font-medium text-gold-700 dark:text-gold-400">
            {formatYearRange(d.historical.startYear, d.historical.endYear)}
          </span>
          {
            d.status !== 'live' && (
              <span class="rounded-full border border-crimson-500/50 px-4 py-1.5 text-base font-medium text-crimson-700 dark:text-crimson-500">
                {d.status === 'broken' ? 'رابط معطّل' : 'قيد المراجعة'}
              </span>
            )
          }
        </div>

        <h1 class="mt-5 text-center font-display text-4xl leading-tight font-bold text-ink-900 sm:text-5xl dark:text-parchment-50">
          {d.title}
        </h1>
        {
          d.titleAlt && (
            <p class="mt-2.5 text-center font-display text-xl text-ink-500 dark:text-parchment-300/60">{d.titleAlt}</p>
          )
        }

        <div class="mt-5 flex items-center justify-center gap-3" aria-hidden="true">
          <span class="h-px w-14 bg-gradient-to-l from-transparent to-gold-500/60"></span>
          <span class="text-base text-gold-600">◈</span>
          <span class="h-px w-14 bg-gradient-to-r from-transparent to-gold-500/60"></span>
        </div>

        <p class="mt-5 text-center text-xl leading-[1.95] text-ink-700 dark:text-parchment-300/85">{d.summary}</p>

        <div class="mt-8">
          {
            d.embed ? (
              <EmbedPlayer embed={d.embed} title={d.title} />
            ) : (
              <Thumb
                thumbnail={d.thumbnail}
                embed={null}
                format={d.format}
                title={d.title}
                class="aspect-[16/7] w-full rounded-2xl border border-parchment-300 dark:border-night-700"
              />
            )
          }
        </div>

        {/* أزرار الخروج */}
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a
            href={d.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-teal-800 px-5 py-3 text-sm font-semibold text-parchment-50 shadow-[var(--shadow-teal)] transition duration-200 ease-[var(--ease-out-soft)] hover:bg-teal-700 active:translate-y-px dark:bg-teal-700 dark:hover:bg-teal-600"
          >
            {outboundLabel}
            <svg viewBox="0 0 24 24" class="size-4 -scale-x-100" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <path d="M15 3h6v6M10 14 21 3" />
            </svg>
            <span class="sr-only">(يفتح في موقع خارجي)</span>
          </a>

          {
            d.publisher?.url && (
              <a
                href={d.publisher.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl border border-parchment-400 px-5 py-3 text-sm font-medium text-ink-700 transition hover:border-gold-400 hover:text-ink-900 dark:border-night-700 dark:text-parchment-300/85 dark:hover:text-parchment-100"
              >
                زُر {d.publisher.name} ↗
              </a>
            )
          }

          <button
            type="button"
            data-open-suggest
            data-mode="report"
            data-url={d.externalUrl}
            class="inline-flex items-center gap-2 rounded-xl border border-crimson-500/40 px-5 py-3 text-sm font-medium text-crimson-700 transition hover:bg-crimson-500/10 dark:text-crimson-500"
          >
            ⚑ الرابط لا يعمل؟
          </button>
        </div>

        <p class="mt-4 text-center text-base text-ink-500 dark:text-parchment-300/55">
          ينقلك هذا الزر إلى موقع خارجي لا نديره ولا نتحكّم في محتواه.
          <span dir="ltr" class="ms-1 font-mono text-sm break-all">{new URL(d.externalUrl).hostname}</span>
        </p>

        {/* لوحة النسبة والحقوق */}
        <section
          aria-labelledby="attribution"
          class="mt-10 rounded-2xl border border-gold-400/50 bg-gold-200/25 p-6 dark:border-gold-600/35 dark:bg-night-900"
        >
          <h2 id="attribution" class="text-center font-display text-2xl font-bold text-ink-900 dark:text-parchment-100">
            النسبة والحقوق
          </h2>
          <dl class="mt-6 grid gap-5 sm:grid-cols-2">
            <div>
              <dt class="text-sm text-ink-500 dark:text-parchment-300/55">المُنتِج / المؤلّف</dt>
              <dd class="mt-1.5 text-lg font-semibold text-ink-900 dark:text-parchment-100">
                {
                  d.creator.url ? (
                    <a href={d.creator.url} target="_blank" rel="noopener noreferrer" class="underline decoration-gold-500/60 underline-offset-4">
                      {d.creator.name} ↗
                    </a>
                  ) : (
                    d.creator.name
                  )
                }
                {d.creator.role && (
                  <span class="block text-xs font-normal text-ink-600 dark:text-parchment-300/70">{d.creator.role}</span>
                )}
              </dd>
            </div>
            <div>
              <dt class="text-sm text-ink-500 dark:text-parchment-300/55">الناشر / المنصّة</dt>
              <dd class="mt-1.5 text-lg font-semibold text-ink-900 dark:text-parchment-100">
                {d.publisher?.name ?? platformLabel(d.sourcePlatform)}
              </dd>
            </div>
            <div>
              <dt class="text-sm text-ink-500 dark:text-parchment-300/55">الترخيص</dt>
              <dd class="mt-1.5 text-lg text-ink-800 dark:text-parchment-200">
                {LICENSES[d.rights.license] ?? d.rights.license}
              </dd>
            </div>
            {
              d.rights.attributionNote && (
                <div>
                  <dt class="text-sm text-ink-500 dark:text-parchment-300/55">ملاحظة</dt>
                  <dd class="mt-1.5 text-lg text-ink-800 dark:text-parchment-200">{d.rights.attributionNote}</dd>
                </div>
              )
            }
          </dl>
          <p class="mt-6 border-t border-gold-500/25 pt-5 text-center text-base leading-relaxed text-ink-600 dark:border-night-700 dark:text-parchment-300/65">
            هذا الأرشيف لا يستضيف الملف ولا يدّعي ملكيته. الإدراج هنا وصفٌ ببليوغرافي وإحالة
            إلى المصدر الأصلي، وكل الحقوق تبقى لصاحبها.
          </p>
        </section>
      </div>

      {/* ————— العمود الجانبي ————— */}
      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-2xl border border-parchment-300 bg-parchment-50 p-6 text-center dark:border-night-700 dark:bg-night-900">
          <h2 class="font-display text-xl font-bold text-ink-900 dark:text-parchment-100">بطاقة الفهرسة</h2>
          <dl class="mt-5 space-y-3.5">
            {
              facts.map((f) => (
                <div class="flex justify-between gap-4 text-base">
                  <dt class="shrink-0 text-ink-500 dark:text-parchment-300/55">{f.k}</dt>
                  <dd class="text-end font-medium text-ink-800 dark:text-parchment-200">{f.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="rounded-2xl border border-parchment-300 bg-parchment-50 p-6 text-center dark:border-night-700 dark:bg-night-900">
          <h2 class="font-display text-xl font-bold text-ink-900 dark:text-parchment-100">المواضيع</h2>
          <ul class="mt-4 flex flex-wrap justify-center gap-2">
            {
              d.topics.map((t: string) => (
                <li>
                  <a
                    href={withBase(`/?topic=${t}`)}
                    class="inline-block rounded-full border border-parchment-300 px-4 py-1.5 text-base text-ink-600 transition hover:border-teal-700 hover:text-teal-800 dark:border-night-700 dark:text-parchment-300/80 dark:hover:text-teal-300"
                  >
                    {topicLabel(t)}
                  </a>
                </li>
              ))
            }
          </ul>

          {
            d.tags.length > 0 && (
              <>
                <h3 class="mt-6 text-base font-semibold tracking-[0.15em] text-teal-800 dark:text-teal-300">وسوم</h3>
                <ul class="mt-3 flex flex-wrap justify-center gap-2">
                  {d.tags.map((t: string) => (
                    <li class="rounded-md bg-parchment-200 px-2.5 py-1 text-sm text-ink-600 dark:bg-night-800 dark:text-parchment-300/75">
                      #{t}
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
      </aside>
    </div>

    {/* ————— ذات صلة ————— */}
    {
      related.length > 0 && (
        <section class="mt-20">
          <SectionHead title="مواد ذات صلة" class="mb-10" />
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r: any, i: number) => (
              <ResourceCard entry={r} eraLabel={eraMap[r.data.historical.eraId]?.label ?? ''} index={i} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
